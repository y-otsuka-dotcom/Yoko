{
  "name": "yoko",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.0.0 <25"
  },
  "packageManager": "npm@11.9.0",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 5173 --strictPort",
    "build": "vite build",
    "build:pages": "vite build --outDir docs",
    "preview": "vite preview --host 127.0.0.1 --port 4173 --strictPort",
    "test": "node --test tests/*.test.js",
    "test:e2e": "npm run build:pages && playwright test"
  },
  "devDependencies": {
    "vite": "8.3.5",
    "@playwright/test": "1.64.1"
  }
}
